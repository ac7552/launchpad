# Keep secrets, local data, and git history out of the image.
/.git/
/.gitignore
/.kamal/secrets*
/.env*
/config/master.key
/config/credentials/*.key
/log/*
/tmp/*
!/tmp/pids/
/tmp/pids/*
!/tmp/pids/.keep
/storage/*
!/storage/.keep
/public/assets
/node_modules/
/test/
/.claude/
/Dockerfile*
/.dockerignore
