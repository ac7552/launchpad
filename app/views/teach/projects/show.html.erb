<% content_for :title, @project.title %>
<section class="hero">
  <div>
    <p class="eyebrow"><%= link_to @project.student.name, teach_student_path(@project.student) %> · <%= @project.stage.name %></p>
    <h1><%= @project.title %></h1>
    <% if @project.spec.present? %><p class="muted">Spec: <%= @project.spec %></p><% end %>
  </div>
  <div class="authorship-summary">
    <span class="share-bar big"><span style="width: <%= @project.kid_share %>%"></span></span>
    <p class="small"><strong><%= @project.kid_share %>%</strong> written by the student · <%= @project.hand_edits_after_ai %> edits after AI code</p>
  </div>
</section>

<% if @open_review %>
  <section class="card" id="grade" style="margin-bottom: 24px">
    <div class="row between">
      <h2 style="margin: 0">Grade this project</h2>
      <span class="muted small">Turned in <%= time_ago_in_words(@open_review.submitted_at).delete_prefix("about ") %> ago</span>
    </div>
    <% if @open_review.student_note %><p class="ask"><strong>Student's note:</strong> <%= @open_review.student_note %></p><% end %>
    <details><summary class="small">Code as turned in</summary><pre class="code"><%= @open_review.code_snapshot %></pre></details>
    <%= form_with model: @open_review, url: teach_project_review_path(@open_review), method: :patch, class: "stack", style: "margin-top: 14px" do |f| %>
      <div>
        <% ProjectReview::CRITERIA.each do |key, c| %>
          <div class="score-row">
            <div><strong><%= c[:name] %></strong><br><span class="muted small"><%= c[:kid] %></span></div>
            <fieldset class="score-pick">
              <legend class="sr-only"><%= c[:name] %> score</legend>
              <% ProjectReview::SCALE.each do |n, word| %>
                <label><%= f.radio_button key, n, required: true %><span><%= n %> · <%= word %></span></label>
              <% end %>
            </fieldset>
            <span></span>
          </div>
        <% end %>
      </div>
      <label class="field"><span>Feedback for <%= @project.student.first_name %></span>
        <%= f.text_area :feedback, rows: 4, required: true, placeholder: "One thing that works, one thing to try next. Short words for younger students." %></label>
      <%= f.submit "Return to #{@project.student.first_name}", class: "btn btn-primary" %>
    <% end %>
  </section>
<% end %>

<% if @returned.any? %>
  <section style="margin-bottom: 24px">
    <p class="label">Grades</p>
    <ol class="rows">
      <% @returned.each do |r| %>
        <li class="row-item"><span class="row-num"><%= r.returned_at.to_date.to_fs(:short) %></span>
          <div><p class="row-meta" style="margin: 0"><% ProjectReview::CRITERIA.each do |key, c| %><%= c[:name] %> <%= r.public_send(key) %>/4 · <% end %><%= r.reviewer&.name %></p><p style="margin: 6px 0 0"><%= r.feedback %></p></div>
        </li>
      <% end %>
    </ol>
  </section>
<% end %>

<div class="two-col">
  <section>
    <h2>Current code <span class="muted small">(highlighted lines came from the coach)</span></h2>
    <pre class="code authored"><% @project.ruby_source.lines.each_with_index do |line, i| %><span class="line <%= 'by-ai' if @project.authorship[i] == 'ai' %>"><%= line.chomp.presence || " " %></span>
<% end %></pre>
  </section>
  <section>
    <h2>AI requests</h2>
    <%= render partial: "teach/reviews/interaction_row", collection: @interactions.reverse, as: :interaction %>
    <h2>History</h2>
    <ol class="history">
      <% @versions.first(30).each do |v| %>
        <li><span class="badge badge-<%= v.author %>"><%= v.author == "ai" ? "Coach" : "Student" %></span> <%= v.created_at.to_fs(:short) %> · <%= pluralize(v.ruby_source.lines.count, "line") %></li>
      <% end %>
    </ol>
  </section>
</div>
