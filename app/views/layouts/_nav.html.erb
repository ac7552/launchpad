<%# Top bar: round buttons, like the world itself. The world is the menu (parents get their own home). %>
<header class="topbar">
  <% if current_user.parent? %>
    <%= link_to family_path, class: "round-link #{'is-here' if controller_name == 'family'}", aria: { label: "Home" } do %>
      <span class="round-btn" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/></svg></span>
      <span class="round-label">Home</span>
    <% end %>
  <% else %>
    <%= link_to root_path, class: "round-link #{'is-here' if current_page?(root_path)}", aria: { label: "Back to the world" } do %>
      <span class="round-btn" aria-hidden="true">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c3 3 3 14 0 17M12 3.5c-3 3-3 14 0 17"/></svg>
      </span>
      <span class="round-label">World</span>
    <% end %>
  <% end %>

  <%= link_to (current_user.parent? ? family_path : root_path), class: "brand", aria: { label: "Launchpad home" } do %><%= brand_mark %><span>launchpad</span><% end %>

  <div class="who">
    <span class="who-name"><%= current_user.student? ? current_user.first_name : current_user.name %></span>
    <%= link_to messages_path, class: "round-btn msg-btn #{'has-unread' if unread_messages?(current_user)}", aria: { label: "Messages" }, title: "Messages" do %>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"/></svg>
    <% end %>
    <span class="avatar" aria-hidden="true"><%= current_user.first_name.first.upcase %></span>
    <%= button_to session_path, method: :delete, class: "round-btn", aria: { label: "Sign out" }, title: "Sign out" do %>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v8M7.5 6.5a7 7 0 1 0 9 0"/></svg>
    <% end %>
  </div>
</header>
