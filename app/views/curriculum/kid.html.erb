<% content_for :title, "Levels" %>
<div class="home">
  <header class="home-head">
    <p class="label">[ <%= format("%02d", @stages.size) %> ] levels</p>
    <h1>Your levels</h1>
    <p class="muted">Tap a level to see what's inside.</p>
  </header>

  <div class="level-list">
    <% start = Stage.for_grade(current_user.grade) %>
    <% @stages.each do |stage| %>
      <% state = stage.position < @current_stage.position ? "done" : (stage == @current_stage ? "current" : "locked") %>
      <% done = stage.milestones.count { |m| @passed.include?(m.id) } %>
      <details class="level-row is-<%= state %>" id="level-<%= stage.key %>" <%= "open" if stage == @selected %>>
        <summary>
          <span class="mini-node is-<%= state %>" aria-hidden="true"><%= state == "locked" ? "🔒" : stage.emoji %></span>
          <span class="level-row-text">
            <span class="label">Level <%= stage.position %></span>
            <span class="level-row-name"><%= stage.kid_name %></span>
          </span>
          <span class="level-row-status">
            <% if state == "current" %><span class="pill pill-green">You are here · <%= done %>/<%= stage.milestones.size %></span>
            <% elsif state == "done" %><span class="pill pill-gold"><%= stage.position >= start.position ? "Done ✓" : "Skipped ahead" %></span>
            <% else %><span class="pill">Locked</span><% end %>
          </span>
          <span class="chevron" aria-hidden="true"></span>
        </summary>
        <div class="level-row-body">
          <%= render "shared/kid_level_body", stage:, passed: @passed, current: stage == @current_stage %>
        </div>
      </details>
    <% end %>
  </div>
</div>
