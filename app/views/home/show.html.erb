<% content_for :title, "Path" %>
<div class="home">
  <header class="home-head">
    <p class="label">[ Level <%= format("%02d", @stage.position) %> ] <%= @stage.kid_name %></p>
    <h1>Hi, <%= @student.first_name %>! 👋</h1>
  </header>

  <% if @last_project %>
    <div class="continue-card">
      <span class="project-emoji" aria-hidden="true"><%= project_emoji(@last_project) %></span>
      <div class="grow">
        <p class="label">Keep going</p>
        <h2><%= @last_project.title %></h2>
      </div>
      <%= link_to "Keep building", @last_project, class: "btn btn-primary btn-lg" %>
    </div>
  <% else %>
    <div class="continue-card">
      <span class="project-emoji" aria-hidden="true">✨</span>
      <div class="grow">
        <p class="label">Let's start</p>
        <h2>Make your first project</h2>
      </div>
      <%= link_to "Start", new_project_path, class: "btn btn-primary btn-lg" %>
    </div>
  <% end %>

  <div class="path-layout">
    <%= render "shared/kid_path", student: @student, stages: @stages, current: @stage, selected: @stage %>
    <%= render "shared/kid_level", stage: @stage, passed: @passed %>
  </div>

  <%= render "shared/kid_rules" %>
</div>
